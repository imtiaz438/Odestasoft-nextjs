# Copy this file to .env.local for local development.
# On Cloudflare, set these as Environment Variables / Secrets in the
# Pages/Workers dashboard (or via `wrangler secret put`) instead — .env.local
# is never deployed.

# Get this from https://resend.com/api-keys after creating a free account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact form submissions get sent.
CONTACT_TO_EMAIL=hello@odestasoft.com

# Who the email appears to be "from". Until you verify your own domain in
# Resend, you MUST use their shared test address below — sending from an
# unverified custom domain will fail.
#   Before domain verification: onboarding@resend.dev
#   After verifying odestasoft.com in Resend:  OdestaSoft <hello@odestasoft.com>
CONTACT_FROM_EMAIL="OdestaSoft Website <onboarding@resend.dev>"
